rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{docId} {
      allow read: if true;
      allow write: if
        request.resource.data.keys().hasOnly(['score', 'notes', 'passed', 'updatedAt']) &&
        request.resource.data.score is string &&
        request.resource.data.score.size() <= 10 &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 500 &&
        (
          !request.resource.data.keys().hasAny(['passed']) ||
          request.resource.data.passed is bool
        );
    }
  }
}
